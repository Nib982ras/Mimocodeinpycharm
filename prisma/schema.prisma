// Secure Multi-Branch Document Exchange System — Database Schema
//
// Role hierarchy (least privilege):
//   OWNER            — sole supreme authority: system activation, emergency
//                      lockdown, license revocation, key destruction.
//   SECURITY_ADMIN   — manages users, branches, keys, audit (no system kill).
//   BRANCH_ADMIN     — manages their own branch's users + documents.
//   USER             — sends/receives encrypted documents as their branch.
//   READONLY         — can view documents only; cannot send or decrypt.
//
// The owner's authority is implemented through an authenticated administrative
// identity + signed revocation commands — NOT a master password or backdoor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton row holding global system state: active/deactivated, lockdown.
model SystemState {
  id            String   @id @default("singleton")
  active        Boolean  @default(true)   // system-wide activation
  lockdown      Boolean  @default(false)  // emergency lockdown
  lockdownReason String?
  lockedBy      String?  // owner username who initiated lockdown
  lockedAt      DateTime?
  updatedAt     DateTime @updatedAt
}

// Hierarchical organization: Headquarters -> Regional -> Department -> Sub-branch
model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  type        String   // HEADQUARTERS | REGIONAL | DEPARTMENT | SUB_BRANCH
  region      String?
  parentId    String?
  parent      Branch?  @relation("BranchHierarchy", fields: [parentId], references: [id])
  children    Branch[] @relation("BranchHierarchy")
  keys        Key[]
  sentDocs    Document[] @relation("SenderDocs")
  receivedDocs Document[] @relation("RecipientDocs")
  auditLogs   AuditLog[]
  users       User[]
  messages    Message[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([type])
}

// User accounts. Roles enforced server-side on every API.
model User {
  id              String    @id @default(cuid())
  username        String    @unique
  displayName     String
  passwordHash    String    // scrypt(salt:hash) hex — never plaintext
  role            String    @default("USER") // OWNER | SECURITY_ADMIN | BRANCH_ADMIN | USER | READONLY
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED
  suspendedReason String?
  suspendedAt     DateTime?
  suspendedBy     String?
  twoFactor       TwoFactor?
  sessions        Session[]
  devices         Device[]
  auditLogs       AuditLog[] @relation("ActorAuditLogs")
  messagesSent    Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([branchId])
  @@index([role])
  @@index([status])
  @@index([username, status])            // Login lookup
}

// TOTP two-factor credentials. Secret encrypted at rest with the master key.
model TwoFactor {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret String   // AES-256-GCM encrypted TOTP secret, base64
  secretIv        String   // base64 IV
  backupCodesHash String   // bcrypt-style scrypt hashes, JSON array
  enabled         Boolean  @default(false)
  enforced        Boolean  @default(false) // admin-enforced for privileged users
  enrolledAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Short-lived session tokens (in addition to the cookie JWT) for revocation.
// When a user is suspended or the system locks down, all their sessions are
// marked revoked so their cookie token is rejected.
model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenJti    String   @unique // unique session id embedded in the JWT
  ipAddress   String?
  userAgent   String?
  fingerprint String?  // SHA-256 of (IP + User-Agent) for session binding
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@index([revoked])
  @@index([userId, revoked])              // Active session count per user
  @@index([createdAt])                    // Stale session cleanup
  @@index([revoked, createdAt])           // Revoked session cleanup
}

// Authorized device/installation. Each device has its own ECC key pair; the
// public key is registered server-side and used to sign license-validation
// challenges. Revoking a device blocks all its future authentication.
model Device {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String   // human label, e.g. "Office PC — Room 204"
  fingerprint     String   @unique // SHA-256 of device public key DER
  publicKeyPem    String
  status          String   @default("ACTIVE") // ACTIVE | REVOKED
  lastSeenAt      DateTime?
  lastSeenIp      String?
  createdAt       DateTime @default(now())
  revokedAt       DateTime?
  revokedBy       String?
  license         License?

  @@index([userId])
  @@index([status])
}

// Cryptographically signed license bound to a device. The license payload
// (deviceId, expiry, scope, tier) is signed with the system's ECDSA licensing
// key; validation verifies the signature rather than trusting spoofable IDs.
model License {
  id            String    @id @default(cuid())
  deviceId      String    @unique
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  licenseKey    String    @unique // human-readable license key
  status        String    @default("ACTIVE") // ACTIVE | EXPIRED | REVOKED | SUSPENDED
  tier          String    @default("STANDARD") // STANDARD | ENTERPRISE | TRIAL
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedBy     String?
  revokeReason  String?
  // Cryptographic signature over {deviceId, expiresAt, tier, issuedAt} with the
  // system's licensing private key (ECDSA-P521-SHA512).
  signature     String    // base64 DER
  signerFingerprint String // SHA-256 of licensing public key

  @@index([status])
  @@index([expiresAt])
}

// Cryptographic key pairs (ECC P-521). Separate keys for ECDH (encryption) and ECDSA (signing).
model Key {
  id                 String   @id @default(cuid())
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  purpose            String   // ENCRYPTION | SIGNING
  algorithm          String   // ECDSA-P521-SHA512 | ECDH-P521
  curve              String   // secp521r1
  publicKeyPem       String
  encryptedPrivateKey String  // AES-256-GCM encrypted, base64
  privateIv          String   // base64 IV used to encrypt the private key
  fingerprint        String   // SHA-256 of public key DER
  status             String   @default("ACTIVE") // ACTIVE | ROTATED | REVOKED | DESTROYED
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  rotatedAt          DateTime?
  revokedAt          DateTime?
  revokedBy          String?
  sentDocuments      Document[] @relation("SenderKeyDocs")
  receivedDocuments  Document[] @relation("RecipientKeyDocs")

  @@index([branchId, purpose])
  @@index([branchId, status, purpose]) // Active key lookup per branch
  @@index([status])
}

// Encrypted document exchange packages
model Document {
  id                 String   @id @default(cuid())
  name               String   // original filename
  mimeType           String
  originalSize       Int      // plaintext size in bytes
  senderBranchId     String
  senderBranch       Branch   @relation("SenderDocs", fields: [senderBranchId], references: [id])
  recipientBranchId  String
  recipientBranch    Branch   @relation("RecipientDocs", fields: [recipientBranchId], references: [id])
  storagePath        String
  ephemeralPublicKey String
  encryptedSessionKey String
  sessionIv          String
  sessionAuthTag     String
  docIv              String
  authTag            String
  signature          String
  senderKeyId        String
  recipientKeyId     String
  senderKey          Key      @relation("SenderKeyDocs", fields: [senderKeyId], references: [id])
  recipientKey       Key      @relation("RecipientKeyDocs", fields: [recipientKeyId], references: [id])
  documentHash       String
  nonce              String
  packageVersion     String   @default("1.0")
  status             String   @default("DELIVERED") // DELIVERED | DECRYPTED | FAILED | PURGED
  createdAt          DateTime @default(now())
  decryptedAt        DateTime?
  auditLogs          AuditLog[]

  @@index([senderBranchId])
  @@index([recipientBranchId])
  @@index([createdAt])
  @@index([senderBranchId, createdAt])     // Sent docs listing per branch
  @@index([recipientBranchId, createdAt])  // Received docs listing per branch
  @@index([status, createdAt])             // Status-filtered queries
}

// Immutable audit trail. Each row is append-only; no UPDATE path is used.
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // LOGIN | LOGOUT | LOGIN_FAILED | 2FA_ENROLL | 2FA_VERIFY | 2FA_FAIL
                       // | UPLOAD | DOWNLOAD | KEY_GEN | KEY_ROTATE | KEY_REVOKE | KEY_DESTROY
                       // | BRANCH_CREATE | SEED | SYSTEM_ACTIVATE | SYSTEM_DEACTIVATE
                       // | LOCKDOWN | LOCKDOWN_RELEASE | USER_SUSPEND | USER_REACTIVATE
                       // | USER_REVOKE | DEVICE_REGISTER | DEVICE_REVOKE | LICENSE_ISSUE
                       // | LICENSE_REVOKE | LICENSE_VALIDATE | UNAUTHORIZED
                       // | MESSAGE_SEND | MESSAGE_READ | MESSAGE_DELETE
  actor       String   // username or "SYSTEM"
  actorId     String?
  actorUser   User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  status      String   // SUCCESS | FAILURE | WARNING
  details     String   // JSON string with context
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([branchId])
  @@index([actorId])
  @@index([action, createdAt])           // Filtered audit queries
  @@index([branchId, createdAt])         // Branch-specific audit listing
  @@index([actorId, createdAt])          // Actor-specific audit listing
  @@index([status, createdAt])           // Status-filtered queries
  @@index([documentId])                  // Document audit trail
}

// Real-time messaging between users. Supports group chats by branch.
// Each message is immutable (no edits/deletes); soft deletion via status.
model Message {
  id            String   @id @default(cuid())
  fromUserId    String
  fromUser      User     @relation("MessagesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId      String?  // null = broadcast to entire branch
  toUser        User?    @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  branchId      String   // branch context (where message originates)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  text          String
  status        String   @default("SENT") // SENT | READ | DELETED
  readAt        DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([branchId])
  @@index([createdAt])
  @@index([status])
}

// Persistent rate limit and brute-force tracking.
// Replaces the in-memory Map with database-backed storage that survives restarts
// and works across multiple instances. Cleaned up periodically.
model RateLimitAttempt {
  id          String   @id @default(cuid())
  key         String   // e.g. "ip:192.168.1.1" or "user:admin"
  action      String   // LOGIN | API | SEED | etc.
  count       Int      @default(1)
  windowStart DateTime @default(now())
  blockedUntil DateTime? // set when threshold exceeded
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, action])
  @@index([key, action])
  @@index([blockedUntil])
  @@index([windowStart])
}
