# PostgreSQL configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_exchange?schema=public

# Redis configuration (optional, falls back to database if not set)
REDIS_URL=redis://localhost:6379

# Storage backend: "local" (default) or "s3"
STORAGE_BACKEND=local

# S3 configuration (required when STORAGE_BACKEND=s3)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=false

# Document expiry/TTL configuration
# DOCUMENT_DEFAULT_RETENTION_DAYS=90
# DOCUMENT_MAX_RETENTION_DAYS=365
# DOCUMENT_EXPIRY_SOFT_DELETE=true

# WebAuthn/FIDO2 configuration
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000

# CAPTCHA protection (optional)
# CAPTCHA_PROVIDER=none  # Options: hcaptcha, recaptcha, turnstile, none
# CAPTCHA_SECRET_KEY=your-secret-key
# CAPTCHA_SITE_KEY=your-site-key
# CAPTCHA_FAILURE_THRESHOLD=5
# CAPTCHA_BLOCK_DURATION=30
